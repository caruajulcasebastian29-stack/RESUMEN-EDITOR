+        with urllib.request.urlopen(req, timeout=60) as r, temporal.open("wb") as f:
+            total = int(r.headers.get("Content-Length") or 0)
+            bajado = 0
+            while True:
+                trozo = r.read(1 << 20)
+                if not trozo:
